---
/**
 * 左栏：个人信息卡（悬停展开二层） + 标签库 / 分类导航
 * 文案全部来自 src/copy.ts
 */
import { site } from "../site.config";
import { copy } from "../copy";

interface Props {
  counts: { posts: number; notes: number; snippets: number; micro: number };
  tags: string[];
  /* 分类切换只在「全部内容」页显示；单独的笔记/代码/随笔页不需要 */
  showKinds?: boolean;
  /* 当前页固定的类型，配合 showKinds=false 用 */
  current?: string;
}

const { counts, tags, showKinds = true, current = "" } = Astro.props;
const social = site.social;
const initial = site.author.name.trim().charAt(0) || "·";

const kindOrder = ["all", "posts", "notes", "snippets", "micro"] as const;
const kindLabel: Record<string, string> = {
  all: copy.kinds.all,
  posts: copy.kinds.posts,
  notes: copy.kinds.notes,
  snippets: copy.kinds.snippets,
  micro: copy.kinds.micro,
};
const kindCount: Record<string, number> = {
  all: counts.posts + counts.notes + counts.snippets + counts.micro,
  posts: counts.posts,
  notes: counts.notes,
  snippets: counts.snippets,
  micro: counts.micro,
};
---

<aside class="sidebar">
  <div class="profile glass" tabindex="0">
    <div class="avatar">
      {site.author.avatar ? <img src={site.author.avatar} alt={site.author.name} /> : initial}
    </div>
    <div class="profile-name">{site.author.name}</div>
    <p class="profile-sign">{copy.profile.sign}</p>

    <div class="profile-more">
      <div class="more-inner">
        <div class="more-body">
          <p class="more-bio">{copy.profile.bio}</p>

          <div class="links">
            {
              social.github && (
                <a href={social.github} target="_blank" rel="noopener" aria-label="GitHub">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                  </svg>
                </a>
              )
            }
            {
              social.bilibili && (
                <a href={social.bilibili} target="_blank" rel="noopener" aria-label="B站">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.2 4.5h-1.9l1.2-1.2a.9.9 0 0 0-1.3-1.3l-2.5 2.5H10.3L7.8 2a.9.9 0 0 0-1.3 1.3l1.2 1.2H5.8A3.8 3.8 0 0 0 2 8.3v9.4A3.8 3.8 0 0 0 5.8 21.5h12.4a3.8 3.8 0 0 0 3.8-3.8V8.3a3.8 3.8 0 0 0-3.8-3.8Zm2 13.2a2 2 0 0 1-2 2H5.8a2 2 0 0 1-2-2V8.3a2 2 0 0 1 2-2h12.4a2 2 0 0 1 2 2v9.4ZM8.2 10.5a1.1 1.1 0 0 1 1.1 1.1v1.6a1.1 1.1 0 0 1-2.2 0v-1.6a1.1 1.1 0 0 1 1.1-1.1Zm7.6 0a1.1 1.1 0 0 1 1.1 1.1v1.6a1.1 1.1 0 0 1-2.2 0v-1.6a1.1 1.1 0 0 1 1.1-1.1Z" />
                  </svg>
                </a>
              )
            }
            {
              social.email && (
                <a href={`mailto:${social.email}`} aria-label="邮箱">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <rect x="2.5" y="5" width="19" height="14" rx="3" />
                    <path d="m3.5 7 8.5 6 8.5-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              )
            }
          </div>

          <div class="stat-grid">
            <div><b data-count={counts.posts}>0</b><span>{copy.stats.posts}</span></div>
            <div><b data-count={counts.notes}>0</b><span>{copy.stats.notes}</span></div>
            <div><b data-count={counts.snippets}>0</b><span>{copy.stats.snippets}</span></div>
            <div><b data-count={counts.micro}>0</b><span>{copy.stats.micro}</span></div>
          </div>

          <a class="code-entry" href="/snippets/">{copy.profile.codeEntry}</a>
        </div>
      </div>
    </div>
  </div>

  <nav class="side-nav glass" aria-label="内容筛选">
    <div class="nav-group">
      <div class="nav-label">{copy.sidebar.tags}</div>
      <div class="chips">
        <button class="chip" type="button" data-tag="*" aria-pressed="true">
          {copy.sidebar.allTags}
        </button>
        {
          tags.map((t) => (
            <button class="chip" type="button" data-tag={t} aria-pressed="false">
              {t}
            </button>
          ))
        }
      </div>
    </div>

    {
      showKinds && (
        <div class="nav-group">
          <div class="nav-label">{copy.sidebar.kinds}</div>
          <div class="side-list" id="sideList" role="tablist" aria-label="内容分类">
            <span class="side-thumb" id="sideThumb" aria-hidden="true" />
            {kindOrder.map((k) => (
              <button
                type="button"
                role="tab"
                data-kind={k}
                aria-selected={k === (current || "all") ? "true" : "false"}
              >
                {kindLabel[k]}
                <span class="count">{kindCount[k]}</span>
              </button>
            ))}
          </div>
        </div>
      )
    }
  </nav>
</aside>

<script>
  function setupSidebar() {
    // ── 悬停展开时，数字从 0 数上去 ──────────────────
    const nums = document.querySelectorAll<HTMLElement>("[data-count]");
  let counted = false;
  const runCount = () => {
    if (counted) return;
    counted = true;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    nums.forEach((el) => {
      const target = Number(el.dataset.count || 0);
      if (reduce || target === 0) {
        el.textContent = String(target);
        return;
      }
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / 600);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  };

  const profile = document.querySelector(".profile");
    profile?.addEventListener("pointerenter", runCount, { once: true });
    profile?.addEventListener("focusin", runCount, { once: true });
  }
  document.addEventListener("astro:page-load", setupSidebar);
</script>

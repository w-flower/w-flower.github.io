---
/**
 * ============================================================
 *  ⌘K 命令面板
 * ------------------------------------------------------------
 *  抄 GitHub / VS Code 的命令面板。回答的是「我现在想干什么」，
 *  而不是「我想搜什么」——所以它同时管搜索和跳转。
 *
 *  索引从哪来：
 *    构建期产出的 /search-index.json（全文，每篇 4000–8000 字全在里面）。
 *    第一次打开面板时拉一次，之后在内存里做子串匹配。
 *    以前是把索引内联进每页 HTML，为了不撑体积只能截到 400 字符，
 *    等于只搜得到标题和开头一段 —— 用户反馈「搜索有跟没有一样」就是这个。
 *
 *  和原搜索框共存，不替代：
 *    /    → 搜本页卡片（在 ContentList 里，同一份索引）
 *    ⌘K   → 搜全站 + 跳转（这里）
 * ============================================================
 */
import { copy } from "../copy";
---

<div class="cmdk" id="cmdk" hidden>
  <div class="cmdk-scrim" id="cmdkScrim"></div>

  <div
    class="cmdk-panel glass"
    role="dialog"
    aria-modal="true"
    aria-label={copy.palette.placeholder}
  >
    <div class="cmdk-head">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m16.5 16.5 4 4" stroke-linecap="round"></path>
      </svg>
      <input
        type="text"
        id="cmdkInput"
        placeholder={copy.palette.placeholder}
        aria-label={copy.palette.placeholder}
        autocomplete="off"
        spellcheck="false"
        aria-controls="cmdkList"
      />
      <button type="button" class="cmdk-x" id="cmdkX" aria-label="关闭">Esc</button>
    </div>

    <div class="cmdk-list" id="cmdkList" role="listbox" aria-label="搜索结果"></div>

    <p class="cmdk-empty" id="cmdkEmpty" hidden></p>

    <div class="cmdk-foot">
      <span><kbd>{copy.palette.keys.up}</kbd><kbd>{copy.palette.keys.down}</kbd> 选</span>
      <span><kbd>{copy.palette.keys.enter}</kbd> 打开</span>
      <span><kbd>{copy.palette.keys.close}</kbd> 关</span>
      <span class="cmdk-count" id="cmdkCount"></span>
    </div>
  </div>
</div>

<button
  type="button"
  class="cmdk-fab"
  id="cmdkFab"
  aria-label={copy.palette.placeholder}
  title={copy.palette.placeholder}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m16.5 16.5 4 4" stroke-linecap="round"></path>
  </svg>
  <kbd>{copy.palette.trigger}</kbd>
</button>

<script>
  import { copy } from "../copy";
  import { loadIndex, hits, snippet, hay, type IndexDoc } from "../lib/search-client";

  const META = {
    posts: { label: copy.kinds.posts, color: "#378ADD" },
    notes: { label: copy.kinds.notes, color: "#5DCAA5" },
    snippets: { label: copy.kinds.snippets, color: "#EF9F27" },
    micro: { label: copy.kinds.micro, color: "#D4537E" },
  };

  /* 常驻操作。输入里出现这些词时也参与匹配 */
  const ACTIONS = [
    { t: copy.palette.actions.home, h: "/", q: "首页 home 主页 index" },
    { t: copy.palette.actions.notes, h: "/notes/", q: "笔记 notes 学习" },
    { t: copy.palette.actions.snippets, h: "/snippets/", q: "代码 snippets code 运行" },
    { t: copy.palette.actions.micro, h: "/micro/", q: "随笔 micro 想法" },
    { t: copy.palette.actions.archive, h: "/archive/", q: "归档 archive 全部" },
    { t: copy.palette.actions.about, h: "/about/", q: "关于 about 简介" },
    { t: copy.palette.actions.kb, h: "/kb/", q: "知识库 kb 图谱 关系" },
    { t: copy.palette.actions.danmaku, h: "/danmaku/", q: "弹幕 danmaku 彩蛋" },
    { t: copy.palette.actions.rss, h: "/rss.xml", q: "rss 订阅 feed" },
  ].map((a) => ({ ...a, q: a.q.toLowerCase() }));

  /* 元素引用 / 开合函数 / 选中态提到模块级：window 在换页后保留，
     全局 ⌘K 监听只绑一次，闭包引用这些模块级变量，换页后由 setupPalette 刷新。 */
  let root: HTMLElement | null, input: HTMLInputElement | null, list: HTMLElement | null, fab: HTMLElement | null;
  let open: () => void, close: () => void;
  let rows: { h: string; t: string; k: string; l: string; c: string; s: string; d?: IndexDoc }[] = [];
  let sel = 0;
  let lastFocus: Element | null = null;

  /* 全站文档，第一次打开面板时拉 */
  let docs: IndexDoc[] | null = null;

  function setupPalette() {
    root = document.getElementById("cmdk");
    const scrim = document.getElementById("cmdkScrim");
    input = document.getElementById("cmdkInput") as HTMLInputElement | null;
    list = document.getElementById("cmdkList");
    const emptyEl = document.getElementById("cmdkEmpty");
    const countEl = document.getElementById("cmdkCount");
    fab = document.getElementById("cmdkFab");
    const xBtn = document.getElementById("cmdkX");
    if (!root || !input || !list) return;

    const LIMIT = 24;
    sel = 0;
    lastFocus = null;

    /* 命中处高亮。只包词本身，别把整段都切成 span */
    const mark = (text: string, q: string) => {
      const frag = document.createDocumentFragment();
      if (!q) {
        frag.appendChild(document.createTextNode(text));
        return frag;
      }
      const low = text.toLowerCase();
      let from = 0;
      let at = low.indexOf(q);
      while (at !== -1) {
        if (at > from) frag.appendChild(document.createTextNode(text.slice(from, at)));
        const b = document.createElement("b");
        b.className = "cmdk-hit";
        b.textContent = text.slice(at, at + q.length);
        frag.appendChild(b);
        from = at + q.length;
        at = low.indexOf(q, from);
      }
      if (from < text.length) frag.appendChild(document.createTextNode(text.slice(from)));
      return frag;
    };

    const rowOf = (d: IndexDoc) => {
      const m = META[d.k as keyof typeof META];
      return {
        h: d.u,
        t: d.t,
        k: d.k,
        l: m?.label ?? "",
        c: m?.color ?? "",
        s: d.s.slice(0, 60),
        d,
      };
    };

    const render = () => {
      const q = input.value.trim().toLowerCase();
      const terms = q.split(/\s+/).filter(Boolean);
      list.textContent = "";

      if (!terms.length) {
        /* 空输入这一屏是「最近写的」+「快速跳转」，比空白有用得多。
           顺序由 /search-index.json 保证（日期倒序）。
           micro 不进最近区：它没有独立详情页，全跳 /micro/，
           占掉几个位置却给不出几个不同去处。 */
        const recent = (docs ?? []).filter((d) => d.k !== "micro").slice(0, 8).map(rowOf);
        const acts = ACTIONS.map((a) => ({ h: a.h, t: a.t, k: "action", l: "", c: "", s: "" }));
        rows = [...recent, ...acts].slice(0, LIMIT);
      } else {
        const list2 = (docs ?? [])
          .filter((d) => hits(d, terms))
          .map((d) => {
            /* 标题命中比正文命中值钱得多，排序要体现 */
            const title = d.t.toLowerCase();
            let s = 0;
            for (const t of terms) {
              if (title.includes(t)) s += title.startsWith(t) ? 12 : 8;
              else if (d.s.toLowerCase().includes(t)) s += 3;
              else if (hay(d).includes(t)) s += 1;
            }
            return { d, s };
          })
          .sort((a, b) => b.s - a.s)
          .slice(0, LIMIT)
          .map((x) => rowOf(x.d));

        const acts = ACTIONS.filter((a) => terms.every((t) => a.q.includes(t))).map((a) => ({
          h: a.h,
          t: a.t,
          k: "action",
          l: "",
          c: "",
          s: "",
        }));
        rows = [...list2, ...acts].slice(0, LIMIT);
      }

      sel = 0;

      for (let i = 0; i < rows.length; i++) {
        const r = rows[i];
        const isAction = r.k === "action";
        const el = document.createElement("a");
        el.className = "cmdk-row" + (isAction ? " is-action" : "");
        el.href = r.h;
        el.setAttribute("role", "option");
        el.dataset.i = String(i);
        el.id = `cmdk-r${i}`;

        if (!isAction && r.c) {
          const dot = document.createElement("span");
          dot.className = "cmdk-dot";
          dot.style.setProperty("--c", r.c);
          el.appendChild(dot);
        }

        const main = document.createElement("span");
        main.className = "cmdk-main";
        const t = document.createElement("span");
        t.className = "cmdk-t";
        t.appendChild(mark(r.t, terms[0] ?? ""));
        main.appendChild(t);

        /* 副行优先显示「正文里的那句原文」——
           只搜到标题的话，用户没法判断是不是要找的那篇。 */
        const snip = terms.length && r.d ? snippet(r.d, terms.find((x) => x.length > 1) ?? terms[0]) : null;
        if (snip) {
          const s = document.createElement("span");
          s.className = "cmdk-s";
          s.appendChild(document.createTextNode(snip.pre));
          const b = document.createElement("b");
          b.className = "cmdk-hit";
          b.textContent = snip.hit;
          s.appendChild(b);
          s.appendChild(document.createTextNode(snip.post));
          main.appendChild(s);
        } else if (r.s) {
          const s = document.createElement("span");
          s.className = "cmdk-s";
          s.textContent = r.s;
          main.appendChild(s);
        }
        el.appendChild(main);

        if (!isAction && r.l) {
          const tag = document.createElement("span");
          tag.className = "cmdk-kind";
          tag.textContent = r.l;
          el.appendChild(tag);
        }

        list.appendChild(el);
      }

      const q2 = input.value.trim();
      if (emptyEl) {
        const none = rows.length === 0 && q2.length > 0;
        emptyEl.hidden = !none;
        if (none) {
          emptyEl.textContent = copy.palette.empty.replace("{q}", q2) + copy.palette.emptyHint;
        }
      }
      if (countEl) countEl.textContent = q2 ? `${rows.length}` : "";
      paint();
    };

    const paint = () => {
      const kids = Array.from(list.children) as HTMLElement[];
      kids.forEach((el, i) => {
        const on = i === sel;
        el.classList.toggle("on", on);
        el.setAttribute("aria-selected", String(on));
      });
      /* 键盘上下时把选中项滚进可视区。scrollIntoView 用 instant，
         否则会跟面板自己的入场动画打架，看着像卡了一下 */
      kids[sel]?.scrollIntoView({ block: "nearest", behavior: "instant" as ScrollBehavior });
      input.setAttribute("aria-activedescendant", `cmdk-r${sel}`);
    };

    open = () => {
      if (!root.hidden) return;
      lastFocus = document.activeElement;
      root.hidden = false;
      /* 下一帧才加 open 类，让浏览器先渲染出初始状态，
         否则入场动画的第一帧就跳过了 */
      requestAnimationFrame(() => root.classList.add("on"));
      /* 浮标让位，不然它会浮在遮罩上面，看着像两层 UI 打架 */
      fab?.classList.add("is-away");
      document.documentElement.style.overflow = "hidden";
      render();
      input.focus();
      input.select();
      /* 第一次打开才拉索引；拉回来若面板还开着就重画一遍 */
      if (!docs) {
        loadIndex().then((d) => {
          docs = d;
          if (root && !root.hidden) render();
        });
      }
    };

    close = () => {
      if (root.hidden) return;
      root.classList.remove("on");
      fab?.classList.remove("is-away");
      document.documentElement.style.overflow = "";
      input.value = "";
      /* 等退场动画走完再 hidden，不然是硬切，动画等于没做 */
      window.setTimeout(() => {
        root.hidden = true;
      }, 180);
      /* 焦点还给原处，否则键盘用户会被丢回 body */
      if (lastFocus instanceof HTMLElement) lastFocus.focus();
      lastFocus = null;
    };

    /* ---- 事件（元素监听：换页后元素已换新，每次重绑，旧元素随 body 销毁不会重复） ---- */
    input.addEventListener("input", render);

    list.addEventListener("click", (e) => {
      const row = (e.target as HTMLElement | null)?.closest?.(".cmdk-row");
      if (row instanceof HTMLElement) {
        /* 不再 preventDefault + location.href（那会触发整页刷新，
           与 ClientRouter 的平滑换页/视图过渡冲突）。这里只关面板，
           让 <a href> 的默认点击交给 Astro ClientRouter 接管，走客户端换页。 */
        close();
      }
    });

    /* 指针划过就切换选中，否则鼠标和键盘的选中会各说各话 */
    list.addEventListener("pointermove", (e) => {
      const row = (e.target as HTMLElement | null)?.closest?.(".cmdk-row");
      if (row instanceof HTMLElement) {
        const i = Number(row.dataset.i);
        if (Number.isFinite(i) && i !== sel) {
          sel = i;
          paint();
        }
      }
    });

    scrim?.addEventListener("click", close);
    xBtn?.addEventListener("click", close);
    fab?.addEventListener("click", () => (root.hidden ? open() : close()));

    /* ⌘K 全局快捷键：document 级，只在首次绑一次（window 换页后保留）。
       闭包引用模块级 root/open/close/rows/sel，换页后由 setupPalette 刷新。 */
    if (!(window as unknown as { __cmdKeyBound?: boolean }).__cmdKeyBound) {
      (window as unknown as { __cmdKeyBound?: boolean }).__cmdKeyBound = true;
      document.addEventListener("keydown", (e) => {
        if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          if (root) root.hidden ? open() : close();
          return;
        }
        if (!root || root.hidden) return;

        if (e.key === "Escape") {
          e.preventDefault();
          close();
        } else if (e.key === "ArrowDown") {
          e.preventDefault();
          if (rows.length) sel = (sel + 1) % rows.length;
          paint();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          if (rows.length) sel = (sel - 1 + rows.length) % rows.length;
          paint();
        } else if (e.key === "Home") {
          e.preventDefault();
          sel = 0;
          paint();
        } else if (e.key === "End") {
          e.preventDefault();
          sel = Math.max(0, rows.length - 1);
          paint();
        } else if (e.key === "Enter") {
          e.preventDefault();
          const href = (list.children[sel] as HTMLAnchorElement | undefined)?.getAttribute("href");
          if (href) location.href = href;
        }
      });
    }
  }
  document.addEventListener("astro:page-load", setupPalette);
</script>

---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { byDateDesc, fmtDate, isPublished } from "../../lib/format";

const snippets = byDateDesc(
  (await getCollection("snippets")).filter((s) => isPublished(s.data))
);
---

<Base title="代码">
  <div class="page-head bg-grid">
    <div class="wrap">
      <h1 class="page-title">代码</h1>
      <p class="page-sub">{snippets.length} snippets</p>
    </div>
  </div>

  <div class="wrap">
    <section class="section" data-reveal>
      <div class="note-grid">
        {
          snippets.map((s) => (
            <a class="note-card" href={`/snippets/${s.id}/`}>
              <div class="note-course">
                {s.data.std} · {fmtDate(s.data.date)}
              </div>
              <h2 class="note-title">{s.data.title}</h2>
              <div class="note-foot">
                {s.data.run ? (
                  <span style="color:var(--accent);">可运行 ↗</span>
                ) : (
                  <span>只读</span>
                )}
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>

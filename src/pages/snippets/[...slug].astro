---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { fmtDate, isPublished } from "../../lib/format";

export async function getStaticPaths() {
  const snippets = await getCollection("snippets");
  return snippets
    .filter((s) => isPublished(s.data))
    .map((snippet) => ({
      params: { slug: snippet.id },
      props: { snippet },
    }));
}

const { snippet } = Astro.props;
const { Content } = await render(snippet);
---

<Base title={snippet.data.title}>
  <article>
    <h1 class="page-title">{snippet.data.title}</h1>
    <p class="meta">
      {snippet.data.std} · {fmtDate(snippet.data.date)}
    </p>

    {
      snippet.data.run && (
        <p style="margin:-16px 0 40px;">
          <a
            href={snippet.data.run}
            target="_blank"
            rel="noopener"
            style="font-size:14px;border-bottom-color:var(--accent);"
          >
            在 Compiler Explorer 里打开 →
          </a>
        </p>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      snippet.data.repo && (
        <p style="margin-top:40px;font-size:14px;color:var(--fg-muted);">
          完整文件：
          <a href={snippet.data.repo} target="_blank" rel="noopener">
            GitHub
          </a>
        </p>
      )
    }

    <p style="margin-top:64px;font-size:13px;color:var(--fg-faint);">
      <a href="/snippets/" style="border-bottom-color:var(--line);">← 返回代码</a>
    </p>
  </article>
</Base>

---
import { getCollection, render } from "astro:content";
import ArticlePage from "../../components/ArticlePage.astro";
import { copy } from "../../copy";
import { isPublished } from "../../lib/format";
import { getRelated } from "../../lib/related";

export async function getStaticPaths() {
  const snippets = await getCollection("snippets");
  return snippets
    .filter((s) => isPublished(s.data))
    .map((snippet) => ({
      params: { slug: snippet.id },
      props: { snippet },
    }));
}

const { snippet } = Astro.props;
const { Content, headings } = await render(snippet);
const d = snippet.data;
const related = await getRelated({ kind: "snippets", id: snippet.id, tags: d.tags });
---

<ArticlePage
  title={d.title}
  date={d.date}
  mood={d.mood}
  tools={d.tools}
  tags={d.tags}
  headings={headings}
  related={related}
  more={[
    { label: "标准", value: d.std },
    {
      label: "运行",
      value: d.run ? "Compiler Explorer" : "只读",
    },
    { label: "仓库", value: d.repo ? "GitHub" : "—" },
  ]}
  backHref="/snippets/"
  backLabel={copy.back.snippets}
>
  <Content />

  {
    d.repo && (
      <p class="doc-repo">
        {copy.snippet.repoLabel}
        <a href={d.repo} target="_blank" rel="noopener">{copy.snippet.repoLink}</a>
      </p>
    )
  }
</ArticlePage>

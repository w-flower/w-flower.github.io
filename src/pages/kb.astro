---
/**
 * 知识库 / Knowledge Base
 *   - 快速索引：标题/课程/标签/正文即时搜索 + 课程筛选
 *   - 知识点桥梁：力导向关系图，节点=笔记/文章/代码，边=同课程/共标签/同章节顺序
 *   - 点节点 => 高亮它的「相关笔记」，下方卡片只留它和邻居
 *   - 支持 ?q= 从起始页带搜索词进来
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { copy } from "../copy";
import { byDateDesc, fmtDate, isPublished } from "../lib/format";

const plain = (s = "") =>
  s
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/^#{1,6}\s+/gm, "")
    .replace(/[*_`~>]/g, "")
    .replace(/\s+/g, " ")
    .trim();

const notes = byDateDesc(
  (await getCollection("notes")).filter((p) => isPublished(p.data))
);
const posts = byDateDesc(
  (await getCollection("posts")).filter((p) => isPublished(p.data))
);
const snippets = byDateDesc(
  (await getCollection("snippets")).filter((p) => isPublished(p.data))
);

const kindMeta: Record<string, { label: string; color: string }> = {
  notes: { label: copy.kinds.notes, color: "#5DCAA5" },
  posts: { label: copy.kinds.posts, color: "#378ADD" },
  snippets: { label: copy.kinds.snippets, color: "#EF9F27" },
};

interface Node {
  id: string;
  href: string;
  title: string;
  kind: string;
  label: string;
  color: string;
  course: string;
  tags: string[];
  q: string;
}

const nodes: Node[] = [];
for (const n of notes) {
  const body = plain((n as { body?: string }).body ?? "").slice(0, 320);
  nodes.push({
    id: `n:${n.id}`,
    href: `/notes/${n.id}/`,
    title: n.data.title,
    kind: "notes",
    label: kindMeta.notes.label,
    color: kindMeta.notes.color,
    course: n.data.course,
    /* 笔记现在有知识点标签（夹逼、连续…）；没写就退回课程名 */
    tags: n.data.tags.length ? n.data.tags : [n.data.course],
    q: `${n.data.title} ${n.data.course} ${body}`.toLowerCase(),
  });
}
for (const p of posts) {
  const body = plain((p as { body?: string }).body ?? "").slice(0, 320);
  nodes.push({
    id: `p:${p.id}`,
    href: `/posts/${p.id}/`,
    title: p.data.title,
    kind: "posts",
    label: kindMeta.posts.label,
    color: kindMeta.posts.color,
    course: "",
    tags: p.data.tags,
    q: `${p.data.title} ${p.data.tags.join(" ")} ${body}`.toLowerCase(),
  });
}
for (const s of snippets) {
  const body = plain((s as { body?: string }).body ?? "").slice(0, 320);
  nodes.push({
    id: `s:${s.id}`,
    href: `/snippets/${s.id}/`,
    title: s.data.title,
    kind: "snippets",
    label: kindMeta.snippets.label,
    color: kindMeta.snippets.color,
    course: "",
    tags: s.data.tags,
    q: `${s.data.title} ${s.data.tags.join(" ")} ${body}`.toLowerCase(),
  });
}

/* 边：同课程（强）/ 共标签（弱）/ 同课程按时间相邻（学习路径） */
const edges: { a: string; b: string; w: number }[] = [];
const byCourse: Record<string, Node[]> = {};
for (const nd of nodes) for (const t of nd.tags) (byCourse[t] ??= []).push(nd);
const seen = new Set<string>();
const addEdge = (a: string, b: string, w: number) => {
  const key = a < b ? `${a}|${b}` : `${b}|${a}`;
  if (seen.has(key) || a === b) return;
  seen.add(key);
  edges.push({ a, b, w });
};
for (const t of Object.keys(byCourse)) {
  const g = byCourse[t];
  // 同课程的笔记按章节顺序连成「学习路径」链（而不是全互联成毛线团）；
  // 这样点一个节点，高亮出来的就是它的上一节 / 下一节，桥梁关系才有意义。
  const seq = [...g].sort((x, y) => x.title.localeCompare(y.title));
  for (let i = 0; i < seq.length - 1; i++) addEdge(seq[i].id, seq[i + 1].id, 2);
}
/* 共标签（文章 / 代码之间，以及笔记之间跨章节的知识点呼应）。
   注意笔记不能按「有共同标签就连」——15 篇同一门课连起来是毛线团。
   这里用标签重合度卡一道：共 2 个以上，或者 Jaccard ≥ 0.5 才连。
   原来是把「同课程」整个跳过，结果所有笔记之间的边都没了，
   点一个圆点只高亮它自己 —— 图看着有、其实什么都没连。 */
const tagSet = new Map(nodes.map((n) => [n.id, new Set(n.tags)]));
const jaccard = (a: string, b: string) => {
  const A = tagSet.get(a), B = tagSet.get(b);
  if (!A || !B) return 0;
  let inter = 0;
  for (const t of A) if (B.has(t)) inter++;
  const uni = A.size + B.size - inter;
  return uni ? inter / uni : 0;
};

for (let i = 0; i < nodes.length; i++)
  for (let j = i + 1; j < nodes.length; j++) {
    const a = nodes[i], b = nodes[j];
    const shared = a.tags.filter((t) => tagSet.get(b.id)?.has(t));
    if (!shared.length) continue;
    if (a.kind !== b.kind) {
      /* 跨类型（笔记 ↔ 代码 / 文章）的呼应很稀有，有一条算一条 */
      addEdge(a.id, b.id, 1);
      continue;
    }
    if (a.kind === "notes" && shared.length < 2 && jaccard(a.id, b.id) < 0.5) continue;
    addEdge(a.id, b.id, 1);
  }

/* 兜底：不允许出现「孤岛节点」。
   孤立点在图上就是个没法点的装饰，点它只会把下面的卡片全藏掉 ——
   用户看到的就是「知识库消失了」。这里给它接一条最近的边。 */
{
  const deg = new Map<string, number>();
  for (const e of edges) {
    deg.set(e.a, (deg.get(e.a) ?? 0) + 1);
    deg.set(e.b, (deg.get(e.b) ?? 0) + 1);
  }
  const isolated = nodes.filter((n) => !deg.get(n.id));
  for (const n of isolated) {
    let best = null, bestScore = -1;
    for (const m of nodes) {
      if (m.id === n.id) continue;
      const score = jaccard(n.id, m.id) * 10 + (m.kind === n.kind ? 1 : 0);
      if (score > bestScore) { bestScore = score; best = m; }
    }
    if (best) addEdge(n.id, best.id, 1);
  }
}

const courses = [...new Set(nodes.flatMap((n) => n.tags))].sort();
const dataStr = JSON.stringify({ nodes, edges, courses })
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e");
---

<Base title="知识库 · Knowledge Base">
  <div class="wrap kb">
    <header class="page-head">
      <h1 class="page-title">知识库 <span class="en">/ Knowledge Base</span></h1>
      <p class="page-sub">快速索引 + 知识点之间的桥。搜得到，也连得上。</p>
    </header>

    <div class="kb-layout">
      <aside class="kb-side">
        <label class="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m16.5 16.5 4 4" stroke-linecap="round" />
          </svg>
          <input
            type="search"
            id="kbSearch"
            placeholder="搜标题、课程、标签、正文…"
            aria-label="搜索知识库"
            autocomplete="off"
          />
        </label>

        <div class="kb-filter">
          <p class="kb-filter-cap">按课程 / 分类</p>
          <div class="chips" id="kbCourses">
            <button class="chip" data-course="*" aria-pressed="true">全部</button>
            {courses.map((c) => <button class="chip" data-course={c} aria-pressed="false">{c}</button>)}
          </div>
        </div>

        <div class="kb-filter">
          <p class="kb-filter-cap">按类型</p>
          <div class="chips" id="kbKinds">
            <button class="chip" data-kind="all" aria-pressed="true">全部</button>
            <button class="chip" data-kind="notes" aria-pressed="false">笔记</button>
            <button class="chip" data-kind="posts" aria-pressed="false">文章</button>
            <button class="chip" data-kind="snippets" aria-pressed="false">代码</button>
          </div>
        </div>

        <p class="kb-hint" id="kbHint">点图里的圆点，会标出它的「相关笔记」。</p>
      </aside>

      <section class="kb-main">
        <div class="kb-graph" id="kbGraph">
          <svg id="kbSvg" viewBox="0 0 900 560" role="img" aria-label="知识点关系图">
            <g id="kbEdges"></g>
            <g id="kbNodes"></g>
          </svg>
        </div>

        <div class="result-line" id="kbResult"></div>
        <div class="cards stagger" id="kbCards">
          {
            nodes.map((nd, i) => (
              <a
                class="card"
                href={nd.href}
                data-id={nd.id}
                data-kind={nd.kind}
                data-course={nd.tags.join("|")}
                data-q={nd.q.slice(0, 4000)}
                style={`--i:${i % 6}`}
              >
                <div class="card-kicker">
                  <span class="kind-dot" style={`--c:${nd.color}`} />
                  {nd.label}
                  <span class="sep">/</span>
                  <span class="dim">{nd.tags.join(" · ")}</span>
                </div>
                <h3 class="card-title">{nd.title}</h3>
                <div class="card-foot"><span>打开 →</span></div>
              </a>
            ))
          }
        </div>
        <p class="empty" id="kbEmpty" hidden>没找着。换个词试试？</p>
      </section>
    </div>
  </div>
</Base>

<style>
  .kb-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 28px;
    align-items: start;
  }
  .kb-side {
    position: sticky;
    top: calc(var(--nav-h) + 16px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .kb-filter-cap {
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    text-transform: uppercase;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    border: 1px solid var(--hairline);
    background: var(--glass);
    color: var(--ink-2);
    border-radius: var(--pill);
    padding: 6px 12px;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: 0.18s;
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .chip[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .kb-hint {
    font-size: 12.5px;
    color: var(--ink-3);
    line-height: 1.6;
    margin: 0;
  }
  .kb-graph {
    background: var(--glass);
    border: 1px solid var(--glass-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 8px;
    backdrop-filter: blur(var(--blur));
    margin-bottom: 22px;
  }
  #kbSvg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* ── 为什么下面全段套 :global() ─────────────────────────────
     SVG 里的圆、线、字全是脚本里 document.createElementNS 造出来的。
     Astro 的 scoped CSS 会把选择器改写成带 [data-astro-cid-xxx] 的形式，
     而动态创建的元素永远拿不到这个属性 —— 一条规则都匹配不上。
     实测后果：节点文字退回浏览器默认 fill:black（深色底上直接看不见）、
     连线退回 stroke:none（整张图只剩一堆浮着的绿点）。
     所以这一层必须走 :global()，不能靠 scoped。 */
  :global(#kbSvg .node circle) {
    cursor: pointer;
    transition: r 0.18s, opacity 0.18s, stroke-width 0.18s;
  }
  :global(#kbSvg .node text) {
    font-size: 11px;
    font-weight: 500;
    fill: var(--ink-2);
    pointer-events: none;
    font-family: var(--font-body);
    /* 文字压在连线上也要能读：描一圈底色当描边，相当于给字加晕 */
    paint-order: stroke;
    stroke: var(--bg-bottom);
    stroke-width: 3.2px;
    stroke-linejoin: round;
  }
  :global(#kbSvg .node) {
    transition: opacity 0.18s;
  }
  :global(#kbSvg .node.dim) {
    opacity: 0.16;
  }
  :global(#kbSvg .node.sel circle) {
    stroke: var(--accent);
    stroke-width: 3px;
  }
  :global(#kbSvg .node:hover circle) {
    stroke: var(--accent);
    stroke-width: 2px;
  }
  :global(#kbSvg .edge) {
    stroke: var(--hairline);
    stroke-width: 1.2px;
    transition: opacity 0.18s, stroke 0.18s;
  }
  :global(#kbSvg .edge.strong) {
    stroke: rgba(91, 141, 239, 0.35);
    stroke-width: 1.6px;
  }
  :global(#kbSvg .edge.dim) {
    opacity: 0.08;
  }
  :global(#kbSvg .edge.hot) {
    stroke: var(--accent);
    stroke-width: 2.2px;
  }
  :global([data-theme="dark"] #kbSvg .edge) {
    stroke: rgba(255, 255, 255, 0.16);
  }
  :global([data-theme="dark"] #kbSvg .edge.strong) {
    stroke: rgba(120, 170, 255, 0.45);
  }
  :global([data-theme="dark"] #kbSvg .node text) {
    stroke: #0b1220;
  }
  .result-line {
    color: var(--ink-3);
    font-size: 13px;
    margin: 4px 2px 14px;
  }
  @media (max-width: 880px) {
    .kb-layout {
      grid-template-columns: 1fr;
    }
    .kb-side {
      position: static;
    }
  }
</style>

<script define:vars={{ dataStr }}>
  const DATA = JSON.parse(dataStr);
  const { nodes, edges } = DATA;
  const W = 900, H = 560;

  /* 固定种子的伪随机：布局必须可复现。
     原来用 Math.random()，同一篇笔记每次刷新都换一个位置，
     视觉上像「东西被挪来挪去」，也让人以为图会自己消失。 */
  let seed = 20260101;
  const rnd = () => {
    seed = (seed * 1664525 + 1013904223) % 4294967296;
    return seed / 4294967296;
  };

  // ---- 力导向布局 ----
  const pos = new Map();
  nodes.forEach((n, i) => {
    const a = (i / nodes.length) * Math.PI * 2;
    pos.set(n.id, {
      x: W / 2 + Math.cos(a) * 220 + (rnd() - 0.5) * 30,
      y: H / 2 + Math.sin(a) * 220 + (rnd() - 0.5) * 30,
      vx: 0, vy: 0,
    });
  });
  /* 迭代次数不跟 prefers-reduced-motion 走：这里没有「动画」，
     只有一次算完就静止的落位。原来 reduce 时 ITER=1，
     结果 15 个点全挤在初始的圆环上互相压住 —— 那才是「图坏了」的观感。 */
  const ITER = 520;

  for (let it = 0; it < ITER; it++) {
    for (let i = 0; i < nodes.length; i++) {
      const a = pos.get(nodes[i].id);
      for (let j = i + 1; j < nodes.length; j++) {
        const b = pos.get(nodes[j].id);
        let dx = a.x - b.x, dy = a.y - b.y;
        let d = Math.hypot(dx, dy) || 0.01;
        const f = 9000 / (d * d);
        const ux = dx / d, uy = dy / d;
        a.vx += ux * f; a.vy += uy * f;
        b.vx -= ux * f; b.vy -= uy * f;
      }
      // 向心力
      a.vx += (W / 2 - a.x) * 0.012;
      a.vy += (H / 2 - a.y) * 0.012;
    }
    for (const e of edges) {
      const a = pos.get(e.a), b = pos.get(e.b);
      let dx = b.x - a.x, dy = b.y - a.y;
      let d = Math.hypot(dx, dy) || 0.01;
      const rest = e.w >= 2 ? 170 : 235;
      const f = (d - rest) * 0.02;
      const ux = dx / d, uy = dy / d;
      a.vx += ux * f; a.vy += uy * f;
      b.vx -= ux * f; b.vy -= uy * f;
    }
    for (const n of nodes) {
      const p = pos.get(n.id);
      p.vx *= 0.85; p.vy *= 0.85;
      p.x += p.vx; p.y += p.vy;
      p.x = Math.max(28, Math.min(W - 28, p.x));
      p.y = Math.max(24, Math.min(H - 24, p.y));
    }
  }

  // ---- 渲染 SVG ----
  const SVGNS = "http://www.w3.org/2000/svg";
  const gEdges = document.getElementById("kbEdges");
  const gNodes = document.getElementById("kbNodes");
  /* 客户端换页回来时脚本会再跑一次，先把上一次画的清掉，
     否则会出现两层节点叠在一起（越逛越糊）。 */
  gEdges.replaceChildren();
  gNodes.replaceChildren();
  const edgeEls = edges.map((e) => {
    const el = document.createElementNS(SVGNS, "line");
    el.setAttribute("class", "edge" + (e.w >= 2 ? " strong" : ""));
    el.dataset.a = e.a; el.dataset.b = e.b;
    gEdges.appendChild(el);
    return el;
  });
  const nodeEls = nodes.map((n) => {
    const g = document.createElementNS(SVGNS, "g");
    g.setAttribute("class", "node");
    g.dataset.id = n.id;
    g.dataset.kind = n.kind;
    g.dataset.course = n.tags.join("|");
    const c = document.createElementNS(SVGNS, "circle");
    c.setAttribute("r", n.kind === "notes" ? 9 : 7);
    c.setAttribute("fill", n.color);
    const t = document.createElementNS(SVGNS, "text");
    t.setAttribute("text-anchor", "middle");
    t.setAttribute("dy", "-14");
    t.textContent = n.title.length > 11 ? n.title.slice(0, 11) + "…" : n.title;
    /* 圆点上挂原生 tooltip：图上只有 11 个字，全名得能查到 */
    const tip = document.createElementNS(SVGNS, "title");
    tip.textContent = n.title;
    g.appendChild(tip);
    g.appendChild(c); g.appendChild(t);
    g.addEventListener("click", () => select(n.id));
    g.addEventListener("mouseenter", () => focusNode(n.id, true));
    g.addEventListener("mouseleave", () => { if (!state.sel) clearFocus(); });
    gNodes.appendChild(g);
    return g;
  });

  function draw() {
    edges.forEach((e, i) => {
      const a = pos.get(e.a), b = pos.get(e.b);
      const l = edgeEls[i];
      l.setAttribute("x1", a.x); l.setAttribute("y1", a.y);
      l.setAttribute("x2", b.x); l.setAttribute("y2", b.y);
    });
    nodes.forEach((n, i) => {
      const p = pos.get(n.id);
      const g = nodeEls[i];
      g.setAttribute("transform", `translate(${p.x},${p.y})`);
    });
  }
  draw();

  // ---- 状态与筛选 ----
  /* 选中态只有一份，放在 state.sel 里。原来另有一个 let sel = null
     从来没被赋值，于是「鼠标移开是否清空高亮」永远走错分支。 */
  const state = { course: "*", kind: "all", q: "", sel: null };
  const cards = [...document.querySelectorAll("#kbCards .card")];
  const search = document.getElementById("kbSearch");
  const result = document.getElementById("kbResult");
  const empty = document.getElementById("kbEmpty");

  /* 全文索引：卡片上的 data-q 只到 4000 字，搜「开覆盖」这类
     出现在后半篇的词会漏。同一份 /search-index.json 补上整篇正文。
     这个脚本是 define:vars 内联的，不能 import，所以判断逻辑就地写一份。 */
  let kbDocs = null;
  const kbHay = (d) => (d.t + " " + d.g + " " + d.s + " " + d.b).toLowerCase();
  fetch("/search-index.json")
    .then((r) => (r.ok ? r.json() : null))
    .then((j) => {
      if (!j || !j.docs) return;
      kbDocs = new Map(j.docs.map((d) => [d.u, d]));
      if (state.q) apply();
    })
    .catch(() => {});

  const neighbors = (id) =>
    new Set(edges.filter((e) => e.a === id || e.b === id).map((e) => (e.a === id ? e.b : e.a)));

  function match(el) {
    if (state.kind !== "all" && el.dataset.kind !== state.kind) return false;
    if (state.course !== "*" && !(el.dataset.course || "").split("|").includes(state.course)) return false;
    if (state.q) {
      const d = kbDocs && kbDocs.get(el.getAttribute("href"));
      if (d) {
        if (!kbHay(d).includes(state.q)) return false;
      } else if (!(el.dataset.q || "").includes(state.q)) {
        return false;
      }
    }
    return true;
  }
  function apply() {
    const vis = cards.filter(match);
    if (state.sel) {
      const nb = neighbors(state.sel);
      cards.forEach((el) => {
        el.hidden = !(el.dataset.id === state.sel || nb.has(el.dataset.id));
      });
    } else {
      cards.forEach((el) => { el.hidden = !vis.includes(el); });
    }
    const shown = cards.filter((el) => !el.hidden);
    result.textContent = `共 ${shown.length} 条` + (state.sel ? "（含相关笔记）" : "");
    empty.hidden = shown.length > 0;
  }

  function focusNode(id, hover) {
    const nb = neighbors(id);
    nodeEls.forEach((g) => {
      const isRel = g.dataset.id === id || nb.has(g.dataset.id);
      g.classList.toggle("dim", !isRel);
      g.classList.toggle("sel", g.dataset.id === id);
    });
    edgeEls.forEach((l) => {
      const hot = l.dataset.a === id || l.dataset.b === id;
      l.classList.toggle("dim", !hot);
      l.classList.toggle("hot", hot);
    });
    if (hover) {
      cards.forEach((el) => {
        const isRel = el.dataset.id === id || nb.has(el.dataset.id);
        el.style.opacity = isRel ? "1" : "0.35";
      });
    }
  }
  function clearFocus() {
    nodeEls.forEach((g) => g.classList.remove("dim", "sel"));
    edgeEls.forEach((l) => l.classList.remove("dim", "hot"));
    cards.forEach((el) => (el.style.opacity = ""));
  }
  function select(id) {
    state.sel = state.sel === id ? null : id;
    if (state.sel) focusNode(state.sel, false);
    else clearFocus();
    apply();
  }

  // 筛选交互
  document.getElementById("kbCourses").querySelectorAll(".chip").forEach((b) =>
    b.addEventListener("click", () => {
      document.querySelectorAll("#kbCourses .chip").forEach((c) => c.setAttribute("aria-pressed", "false"));
      b.setAttribute("aria-pressed", "true");
      state.course = b.dataset.course;
      apply();
    })
  );
  document.getElementById("kbKinds").querySelectorAll(".chip").forEach((b) =>
    b.addEventListener("click", () => {
      document.querySelectorAll("#kbKinds .chip").forEach((c) => c.setAttribute("aria-pressed", "false"));
      b.setAttribute("aria-pressed", "true");
      state.kind = b.dataset.kind;
      apply();
    })
  );
  let deb = 0;
  search.addEventListener("input", () => {
    clearTimeout(deb);
    deb = setTimeout(() => {
      state.q = (search.value || "").trim().toLowerCase();
      apply();
    }, 150);
  });

  // 起始页 ?q= 带词进来
  const qp = new URLSearchParams(location.search).get("q");
  if (qp) { search.value = qp; state.q = qp.toLowerCase(); }
  apply();
</script>

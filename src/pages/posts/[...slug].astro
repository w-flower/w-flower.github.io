---
import { getCollection, render } from "astro:content";
import ArticlePage from "../../components/ArticlePage.astro";
import { copy } from "../../copy";
import { isPublished } from "../../lib/format";
import { getRelated } from "../../lib/related";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((p) => isPublished(p.data))
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const related = await getRelated({ kind: "posts", id: post.id, tags: d.tags });
---

<ArticlePage
  title={d.title}
  date={d.date}
  mood={d.mood}
  tools={d.tools}
  tags={d.tags}
  headings={headings}
  related={related}
  more={[
    { label: "分类", value: "文章" },
    { label: "摘要", value: d.summary },
  ]}
  backHref="/posts/"
  backLabel={copy.back.posts}
>
  <Content />
</ArticlePage>

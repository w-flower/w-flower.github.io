---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { fmtDate, isPublished } from "../../lib/format";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((p) => isPublished(p.data))
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.summary}>
  <article>
    <h1 class="page-title">{post.data.title}</h1>
    <p class="meta">
      {fmtDate(post.data.date)}
      {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { copy } from "../../copy";
import { byDateDesc, fmtDate, isPublished } from "../../lib/format";

const posts = byDateDesc(
  (await getCollection("posts")).filter((p) => isPublished(p.data))
);
---

<Base title={copy.listPages.posts.title}>
  <div class="page-head bg-grid">
    <div class="wrap">
      <h1 class="page-title">{copy.listPages.posts.title}</h1>
      <p class="page-sub">{posts.length} {copy.listPages.posts.sub}</p>
    </div>
  </div>

  <div class="wrap">
    <section class="section" data-reveal>
      <div class="bento">
        {
          posts.length === 0 && (
            <p class="card-desc" style="grid-column:span 2;">
              {copy.empty.posts}
            </p>
          )
        }
        {
          posts.map((post, i) => (
            <a
              class={i === 0 ? "card wide" : "card"}
              href={`/posts/${post.id}/`}
            >
              <div class="card-kicker">
                <span>{fmtDate(post.data.date)}</span>
                {post.data.tags.length > 0 && <span class="sep">/</span>}
                <span class="dim">{post.data.tags.join(" · ")}</span>
              </div>
              <h2 class="card-title">{post.data.title}</h2>
              <p class="card-desc">{post.data.summary}</p>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>

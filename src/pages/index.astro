---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { site } from "../site.config";
import { byDateDesc, fmtDate, isPublished } from "../lib/format";

const posts = byDateDesc(
  (await getCollection("posts")).filter((p) => isPublished(p.data))
);
const notes = byDateDesc(
  (await getCollection("notes")).filter((p) => isPublished(p.data))
);
const snippets = (await getCollection("snippets")).filter((p) =>
  isPublished(p.data)
);
const micros = byDateDesc(
  (await getCollection("micro")).filter((p) => isPublished(p.data))
);

const recentPosts = posts.slice(0, 5);
const recentNotes = notes.slice(0, 4);
const recentMicros = micros.slice(0, 3);

const microItems = await Promise.all(
  recentMicros.map(async (m) => ({
    date: m.data.date,
    Content: (await render(m)).Content,
  }))
);

const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
const statusText: Record<string, string> = {
  seed: "刚记下",
  growing: "在长",
  evergreen: "已成熟",
};
const filler = [
  "c++",
  "数据结构",
  "现代 c++",
  "内存管理",
  "算法",
  "learn in public",
  "keep writing",
  "notes to self",
];
const marqueeItems = [...new Set([...tags, ...filler])].slice(0, 9);
---

<Base>
  <section class="hero bg-grid" data-reveal>
    <div class="wrap hero-inner">
      <h1>
        把想明白的事记下来，<br />
        把没想明白的<em>也记下来</em>。
      </h1>
      <p class="hero-sub">{site.author.bio}</p>
      <div class="hero-meta">
        <span class="pill accent">{posts.length} 篇文章</span>
        <span class="pill">{notes.length} 篇笔记</span>
        <span class="pill">{snippets.length} 段代码</span>
        <span class="pill">{micros.length} 条随笔</span>
      </div>
    </div>
  </section>

  <div class="marquee">
    <div class="marquee-track">
      {
        [0, 1, 2, 3].map(() =>
          marqueeItems.map((t) => <span>{t}</span>)
        )
      }
    </div>
  </div>

  <div class="wrap">
    <section class="section" data-reveal>
      <div class="section-head">
        <h2 class="section-title">文章 / Posts</h2>
        <a class="section-more" href="/posts/">全部 →</a>
      </div>

      <div class="bento">
        {
          recentPosts.length === 0 && (
            <p class="card-desc" style="grid-column:span 2;">
              还没有文章。第一篇文章从一个你想不明白的问题开始。
            </p>
          )
        }
        {
          recentPosts.map((post, i) => (
            <a
              class={i === 0 ? "card wide" : "card"}
              href={`/posts/${post.id}/`}
            >
              <div class="card-kicker">
                <span>{fmtDate(post.data.date)}</span>
                {post.data.tags.length > 0 && <span class="sep">/</span>}
                <span class="dim">{post.data.tags.join(" · ")}</span>
              </div>
              <h3 class="card-title">{post.data.title}</h3>
              <p class="card-desc">{post.data.summary}</p>
            </a>
          ))
        }
      </div>
    </section>

    {
      recentNotes.length > 0 && (
        <section class="section" data-reveal>
          <div class="section-head">
            <h2 class="section-title">笔记 / Notes</h2>
            <a class="section-more" href="/notes/">全部 →</a>
          </div>
          <div class="note-grid">
            {recentNotes.map((note) => (
              <a class="note-card" href={`/notes/${note.id}/`}>
                <div class="note-course">{note.data.course}</div>
                <h3 class="note-title">{note.data.title}</h3>
                <div class="note-foot">
                  <span class={`dot ${note.data.status}`} />
                  <span>{statusText[note.data.status]}</span>
                  <span style="opacity:0.6">{fmtDate(note.data.date)}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      microItems.length > 0 && (
        <section class="section" data-reveal>
          <div class="section-head">
            <h2 class="section-title">随笔 / Micro</h2>
            <a class="section-more" href="/micro/">全部 →</a>
          </div>
          <div>
            {microItems.map((m) => (
              <div class="stream-item" style="max-width:620px;">
                <div class="stream-date">{fmtDate(m.date)}</div>
                <div class="stream-body">
                  <m.Content />
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

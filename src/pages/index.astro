---
/**
 * 首页 = 封面页
 *   顶部导航（在 Base 里） / 左半区个人信息 + 音乐 / 右半区 2×2 入口 / 底部名句栏
 * 全部文案在 src/copy.ts 的 home / music / quotes
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import QuoteBar from "../components/QuoteBar.astro";
import { site } from "../site.config";
import { copy } from "../copy";
import { isPublished } from "../lib/format";

const counts = {
  notes: (await getCollection("notes")).filter((p) => isPublished(p.data)).length,
  snippets: (await getCollection("snippets")).filter((p) => isPublished(p.data))
    .length,
  micro: (await getCollection("micro")).filter((p) => isPublished(p.data)).length,
};

const unit: Record<string, string> = {
  notes: "篇",
  snippets: "段",
  micro: "条",
};

const icons: Record<string, string> = {
  about:
    '<circle cx="12" cy="8.2" r="3.6"/><path d="M4.5 20c.9-3.6 3.9-5.6 7.5-5.6s6.6 2 7.5 5.6"/>',
  notes:
    '<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5.5A1.5 1.5 0 0 1 4 18.5z"/><path d="M8 8.5h7M8 12h7M8 15.5h4"/>',
  snippets:
    '<path d="M9 6.5 4 12l5 5.5M15 6.5 20 12l-5 5.5"/>',
  micro:
    '<path d="M15.5 4.5 19.5 8.5 8.5 19.5H4.5v-4z"/><path d="M13.5 6.5 17.5 10.5"/>',
  kb: '<path d="M12 3 3 8l9 5 9-5-9-5ZM3 8v8l9 5 9-5V8M12 13v8"/>',
  start:
    '<circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round"/>',
};

/* 外链图标：地址没填也照样显示，只是变成灰色不可点。
   地址在 src/site.config.ts 的 social 里填。 */
const socials = [
  {
    key: "GitHub",
    url: site.social.github,
    vb: "0 0 16 16",
    d: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"',
  },
  {
    key: "B站",
    url: site.social.bilibili,
    vb: "0 0 24 24",
    d: 'M18.2 4.5h-1.9l1.2-1.2a.9.9 0 0 0-1.3-1.3l-2.5 2.5H10.3L7.8 2a.9.9 0 0 0-1.3 1.3l1.2 1.2H5.8A3.8 3.8 0 0 0 2 8.3v9.4A3.8 3.8 0 0 0 5.8 21.5h12.4a3.8 3.8 0 0 0 3.8-3.8V8.3a3.8 3.8 0 0 0-3.8-3.8Zm2 13.2a2 2 0 0 1-2 2H5.8a2 2 0 0 1-2-2V8.3a2 2 0 0 1 2-2h12.4a2 2 0 0 1 2 2v9.4ZM8.2 10.5a1.1 1.1 0 0 1 1.1 1.1v1.6a1.1 1.1 0 0 1-2.2 0v-1.6a1.1 1.1 0 0 1 1.1-1.1Zm7.6 0a1.1 1.1 0 0 1 1.1 1.1v1.6a1.1 1.1 0 0 1-2.2 0v-1.6a1.1 1.1 0 0 1 1.1-1.1Z"',
  },
];
---

<Base hideFooter>
  <div class="cover wrap">
    <div class="cover-grid">
      <section class="cover-left" data-reveal>
        <h1 class="cover-name grad-text">{copy.home.title}</h1>

        <div class="cover-avatar">
          {
            site.author.avatar ? (
              <img src={site.author.avatar} alt={site.author.name} />
            ) : (
              <span>{site.author.name.charAt(0)}</span>
            )
          }
        </div>

        <p class="cover-sign">{copy.home.subtitle}</p>

        <div class="cover-links">
          {
            socials.map((s) =>
              s.url ? (
                <a href={s.url} target="_blank" rel="noopener" aria-label={s.key} title={s.key}>
                  <svg viewBox={s.vb} fill="currentColor" aria-hidden="true" set:html={`<path d="${s.d}"/>`} />
                </a>
              ) : (
                <span class="link-off" title={`${s.key} · 去 src/site.config.ts 里填链接`}>
                  <svg viewBox={s.vb} fill="currentColor" aria-hidden="true" set:html={`<path d="${s.d}"/>`} />
                </span>
              )
            )
          }
          {
            site.social.email && (
              <a href={`mailto:${site.social.email}`} aria-label="邮箱" title="邮箱">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <rect x="2.5" y="5" width="19" height="14" rx="3" />
                  <path d="m3.5 7 8.5 6 8.5-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )
          }
        </div>

        <div class="cover-music">
          <MusicPlayer />
        </div>
      </section>

      <section class="cover-right" data-reveal>
        <div class="entry-grid">
          {
            copy.home.entries.map((e, i) => (
              <a
                class="entry"
                href={e.href}
                style={`--i:${i}`}
                data-entry={e.key}
              >
                <svg
                  class="entry-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={icons[e.key] ?? ""}
                />
                {e.en && <span class="entry-en">{e.en}</span>}
                <h2 class="entry-title">{e.title}</h2>
                <p class="entry-desc">{e.desc}</p>
                <!-- 计数和箭头放进同一个底行。
                     原来它们是各自 position:absolute 钉在卡片底部的，
                     描述文字一换行（手机窄屏必然换行）就会压到它们上面。
                     改成正常流 + margin-top:auto，卡片自己会长高，不会重叠。 -->
                <span class="entry-foot">
                  <span class="entry-count">
                    {counts[e.key] !== undefined ? `${counts[e.key]} ${unit[e.key]}` : ""}
                  </span>
                  <span class="entry-go" aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>
    </div>

    <QuoteBar />
  </div>
</Base>

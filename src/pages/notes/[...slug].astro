---
import { getCollection, render } from "astro:content";
import ArticlePage from "../../components/ArticlePage.astro";
import { copy } from "../../copy";
import { isPublished } from "../../lib/format";
import { getRelated } from "../../lib/related";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes
    .filter((n) => isPublished(n.data))
    .map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const d = note.data;
const related = await getRelated({ kind: "notes", id: note.id, course: d.course });
---

<ArticlePage
  title={d.title}
  date={d.date}
  mood={d.mood}
  tools={d.tools}
  tags={[d.course, ...(d.tags || [])]}
  headings={headings}
  related={related}
  more={[
    { label: "课程", value: d.course },
    { label: "状态", value: copy.noteStatus[d.status] },
  ]}
  backHref="/notes/"
  backLabel={copy.back.notes}
>
  <Content />
</ArticlePage>

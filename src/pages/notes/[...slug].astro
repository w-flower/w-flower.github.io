---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { fmtDate, isPublished } from "../../lib/format";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes
    .filter((n) => isPublished(n.data))
    .map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const statusText: Record<string, string> = {
  seed: "刚记下",
  growing: "在长",
  evergreen: "已成熟",
};
---

<Base title={note.data.title}>
  <header class="article-head bg-grid">
    <div class="wrap narrow">
      <div class="article-meta" data-reveal>
        <span style="display:inline-flex;align-items:center;gap:8px;">
          <span class={`dot ${note.data.status}`} />
          {statusText[note.data.status]}
        </span>
        <span class="bar"></span>
        <span>{note.data.course}</span>
        <span class="bar"></span>
        <span>{fmtDate(note.data.date)}</span>
      </div>
      <h1 class="article-title" data-reveal>{note.data.title}</h1>
    </div>
  </header>

  <div class="wrap narrow">
    <div class="prose" data-reveal>
      <Content />
    </div>
    <a class="back-link" href="/notes/">← 返回笔记</a>
  </div>
</Base>

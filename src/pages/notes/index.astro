---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { byDateDesc, fmtDate, isPublished } from "../../lib/format";

const notes = byDateDesc(
  (await getCollection("notes")).filter((n) => isPublished(n.data))
);

const groups = new Map<string, typeof notes>();
for (const n of notes) {
  const key = n.data.course;
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(n);
}

const statusText: Record<string, string> = {
  seed: "刚记下",
  growing: "在长",
  evergreen: "已成熟",
};
---

<Base title="笔记">
  <div class="page-head bg-grid">
    <div class="wrap">
      <h1 class="page-title">笔记</h1>
      <p class="page-sub">{notes.length} notes</p>
    </div>
  </div>

  <div class="wrap">
    <section class="section" data-reveal>
      <div class="hero-meta" style="margin-bottom:8px;">
        <span class="pill"><span class="dot seed" style="margin-right:7px;"></span>刚记下</span>
        <span class="pill"><span class="dot growing" style="margin-right:7px;"></span>在长</span>
        <span class="pill"><span class="dot evergreen" style="margin-right:7px;"></span>已成熟</span>
      </div>

      {
        [...groups.entries()].map(([course, items]) => (
          <>
            <div class="group-label">{course}</div>
            <div class="note-grid">
              {items.map((note) => (
                <a class="note-card" href={`/notes/${note.id}/`}>
                  <div class="note-course">{fmtDate(note.data.date)}</div>
                  <h2 class="note-title">{note.data.title}</h2>
                  <div class="note-foot">
                    <span class={`dot ${note.data.status}`} />
                    <span>{statusText[note.data.status]}</span>
                  </div>
                </a>
              ))}
            </div>
          </>
        ))
      }
    </section>
  </div>
</Base>

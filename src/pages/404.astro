---
import Base from "../layouts/Base.astro";
import { copy } from "../copy";

const lines = copy.notFound.lines;
const line = lines[Math.floor(Math.random() * lines.length)];
---

<Base title={copy.notFound.title}>
  <div class="wrap">
    <div class="notfound">
      <p class="huge">{copy.notFound.title}</p>
      <p class="line" data-reveal>{line}</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;" data-reveal>
        <a class="btn" href="/">{copy.notFound.home}</a>
        <a class="btn ghost" href="/micro/">{copy.notFound.micro}</a>
      </div>
    </div>
  </div>
</Base>

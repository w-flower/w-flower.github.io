---
import Base from "../layouts/Base.astro";

const excuses = [
  "这个页面没被写出来，或者已经被删掉了。",
  "可能是链接打错了，也可能是我把它改没了。",
  "这条路通向一堵墙。",
  "有些东西不存在，本身就是一种存在。",
];

const line = excuses[Math.floor(Math.random() * excuses.length)];
---

<Base title="404">
  <div class="wrap">
    <div class="notfound">
      <p class="huge">404</p>
      <p class="line" data-reveal>{line}</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;" data-reveal>
        <a class="btn" href="/">回首页</a>
        <a class="btn ghost" href="/micro/">逛逛随笔</a>
      </div>
    </div>
  </div>
</Base>
